# =====================================================================
# Production env template — Internal Production Deployment, Wave 1
#
# Copy this file to .env.prod on the production VM and fill in the
# real values:
#
#     cp .env.prod.example .env.prod
#     chmod 600 .env.prod         # only the deploying user can read it
#
# Do NOT commit .env.prod. Only this .example file is committed.
# .env.prod is intentionally listed in deploy/.gitignore.
#
# Reference: see ../.env.example (line by line) for the full set of
# variables the FastAPI app understands. This file is the *production-
# specific subset* — variables whose value differs between local dev
# and the VM, plus all secrets.
# =====================================================================

# ---------------------------------------------------------------------
# 1) Public hostname + TLS contact
# ---------------------------------------------------------------------
# Domain Caddy obtains a Let's Encrypt cert for and serves the WebUI on.
# Decision recorded in Internal_Production_Deployment_Plan.md §3.7.
AIX_DOMAIN=agente.aiforlearning.digital

# Email Let's Encrypt uses for renewal warnings + recovery contact. Use a
# real mailbox someone monitors. Hide it at the registrar level if needed
# (Let's Encrypt does not publish it, but Caddy stores it in caddy_data).
AIX_TLS_EMAIL=devops@example.com


# ---------------------------------------------------------------------
# 2) Postgres credentials (single instance, two databases logically)
# ---------------------------------------------------------------------
# Used by the postgres service on first boot and by the app to derive
# WEBUI_DATABASE_URL + LANGGRAPH_DATABASE_URL inside compose. Pick a
# strong randomly-generated password (e.g. `openssl rand -base64 32`).
POSTGRES_USER=aix
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=aix

# WEBUI_DATABASE_URL and LANGGRAPH_DATABASE_URL are NOT set here — the
# compose file derives them from the three POSTGRES_* values above so
# rotating the password requires editing only one place.


# ---------------------------------------------------------------------
# 3) Neo4j (external — already running)
# ---------------------------------------------------------------------
# Production Neo4j lives on the existing FEM-managed instance. Same URI
# the app uses today; only NEO4J_PASSWORD differs from local.
NEO4J_URI=bolt+s://graph.aiforlearning.digital:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-prod-neo4j-password
NEO4J_ENCRYPTED=1


# ---------------------------------------------------------------------
# 4) LLM provider (OpenRouter) + fallback (OpenAI)
# ---------------------------------------------------------------------
# Use a production-billing OpenRouter key, NOT the developer's personal
# one. Rotate via the OpenRouter dashboard if the VM is ever
# compromised.
OPENROUTER_API_KEY=replace-with-prod-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4-6

# OpenAI is only used if OPENROUTER_API_KEY is empty. Leave blank in prod
# unless we are explicitly running on OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o


# ---------------------------------------------------------------------
# 5) Embeddings + Text2Cypher (no secrets, kept aligned with .env.example
# defaults so behaviour is deterministic)
# ---------------------------------------------------------------------
EMBEDDING_MODE=hybrid_semantic
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_NODE2VEC_WEIGHT=0.4
EMBEDDING_SEMANTIC_THRESHOLD=0.7
EMBEDDINGS_CACHE_DIR=artifacts/embeddings_cache
EMBEDDING_CACHE_EMBEDDINGS=true
NODE2VEC_MODEL_DIR=./artifacts/node2vec

TEXT2CYPHER_MODEL=google/gemini-2.5-flash
TEXT2CYPHER_MAX_QUERY_LENGTH=1000
TEXT2CYPHER_DEFAULT_LIMIT=20
TEXT2CYPHER_ENABLE_VALIDATION=true
TEXT2CYPHER_ENABLE_EXECUTION=true


# ---------------------------------------------------------------------
# 6) Observability
# ---------------------------------------------------------------------
# GlitchTip / Sentry-compatible. Use a production project DSN distinct
# from dev so error volumes are separable.
SENTRY_DSN=
ENVIRONMENT=production
LOG_LEVEL=INFO

# Langfuse — already used today for prompt management; tracing dashboard
# work is tracked under CORE 2 #11b. Keep the prod credentials here so
# the app can reach Langfuse cloud from inside the container.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# ---------------------------------------------------------------------
# 7) Agent feature flags (production defaults)
# ---------------------------------------------------------------------
# Corrective RAG is OFF by default in prod — the May 2026 latency
# investigation showed multi-attempt retry can push P95 over 500s on
# out-of-scope queries. Re-enable only after CORE 3.5 hardening lands.
AIX_CORRECTIVE_RAG_ENABLED=false
AIX_CORRECTIVE_RAG_MAX_ATTEMPTS=2

# Critic fallback behaviour on JSON parse failure. 'approve' = legacy
# (lesson ships, parse_error logged). Switch to 'revise' once #11b
# confirms the parse-error rate is near-zero with json_mode on.
AIX_CRITIC_PARSE_ERROR_BEHAVIOR=approve

# Hard cap on writer tokens so a runaway lesson can never burn through
# the OpenRouter budget on a single request.
AIX_WRITER_MAX_TOKENS=2000

# Conversation-memory window (CORE 2 #10.4). Default 4 turns is a good
# starting point for the pilot; can be tuned from this env var without
# redeploy.
AIX_CONVERSATION_WINDOW_TURNS=4

# Dynamic media layer (off-critical-path live media enrichment). Enabled here
# to mirror the current validated local behavior; disable if we want the first
# pilot deploy to use only the curated media pool.
AIX_MEDIA_LIVE_ENABLED=true
# Semantic reranking of live media results against the query + lesson content.
# Only affects which fetched items are shown and in what order; fail-safe.
AIX_MEDIA_RERANK_ENABLED=true

# Concurrency controls (CORE 6 — Phase A, single-worker hardening).
# PER-PROCESS limits; with multiple workers each worker gets its own caps,
# so size AIX_MAX_CONCURRENT_RUNS × workers against the VM's CPU/RAM and the
# OpenRouter rate limit. Tune without a code deploy.
#   • Max simultaneous full pipelines; the rest queue then shed (503 / busy card).
AIX_MAX_CONCURRENT_RUNS=6
#   • Seconds a request waits for a free slot before shedding (0 = shed at once).
AIX_RUN_QUEUE_TIMEOUT_S=5.0
#   • Hard ceiling on simultaneous outbound LLM calls (guards against 429s/cost).
AIX_MAX_CONCURRENT_LLM_CALLS=12
#   • Per-user run budget: max runs a single teacher may START per window
#     (rolling). 0 disables. Keyed per-process (webui:<id> / api:<caller>).
AIX_USER_RATE_LIMIT=10
#   • Rolling window (seconds) for the per-user run budget above.
AIX_USER_RATE_WINDOW_S=60.0

# Cross-worker run registry (CORE 6 — Phase B #37).
# In production this MUST use the shared Postgres WebUI DB so all workers see
# the same in-flight lesson runs. `auto` selects DB-backed mode whenever
# WEBUI_DATABASE_URL is Postgres; `memory` is a kill-switch that reverts to
# single-process behaviour and must NOT be used for multi-worker deploys.
AIX_RUN_REGISTRY=auto
#   • Heartbeat cadence for active DB-backed run rows.
AIX_RUN_HEARTBEAT_INTERVAL_S=15.0
#   • A row older than this is considered stale/crashed and can be reclaimed.
AIX_RUN_HEARTBEAT_TTL_S=60.0


# ---------------------------------------------------------------------
# 8) WebUI / CORS
# ---------------------------------------------------------------------
# Lock CORS to the production domain so cross-origin browsers from any
# other host are rejected. Comma-separated list if multiple origins
# need access (e.g. AixLearning iframe embed in CORE 6).
WEBUI_CORS_ALLOW_ORIGINS=https://agente.aiforlearning.digital

# Secret used to sign WebUI auth/reset/verification tokens. Required in
# production; never use the dev fallback. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_AUTH_SECRET=replace-with-strong-random-secret

# Send auth cookies only over HTTPS in production. Required behind Caddy/TLS.
WEBUI_COOKIE_SECURE=1


# ---------------------------------------------------------------------
# 9) Build metadata (set automatically by CI; safe defaults below)
# ---------------------------------------------------------------------
# Captured by the Dockerfile via ARG and exposed at runtime as
# CODE_VERSION. Override on the build host with `--build-arg GIT_SHA=...`
# or by exporting GIT_SHA before `docker compose build`.
GIT_SHA=dev
