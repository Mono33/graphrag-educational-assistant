# ============================================================
# GraphRAG AixLearning — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================


# ============================================================
# NEO4J CONFIGURATION
# ============================================================

# Connection URI — bolt+s:// for TLS (Aura, FEM server), bolt:// for local
NEO4J_URI=bolt+s://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Set to 1 for encrypted connections (bolt+s://), 0 for plain bolt://
NEO4J_ENCRYPTED=1


# ============================================================
# LLM — OPENROUTER CONFIGURATION
# ============================================================

# Primary API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback: original OpenAI key — used only if OPENROUTER_API_KEY is not set.
# If you are fully on OpenRouter, leave this commented out.
# OPENAI_API_KEY=sk-proj-your-openai-key-here

# Active LLM model — use OpenRouter model IDs (see https://openrouter.ai/models)
# Standard models (temperature + max_tokens):
#   openai/gpt-4o                     GPT-4o
#   anthropic/claude-sonnet-4-6       Claude Sonnet 4.6  <- recommended
#   google/gemini-2.0-flash           Gemini Flash (fast, cheap)
# Reasoning models (no temperature, thinking tokens):
#   openai/o4-mini                    OpenAI o4-mini
#   deepseek/deepseek-r1              DeepSeek R1 (free tier available)
LLM_MODEL=anthropic/claude-sonnet-4-6


# ============================================================
# EMBEDDING CONFIGURATION
# ============================================================

# Embedding mode — controls how nodes are retrieved from the knowledge graph:
#
#   node2vec        Uses only pre-trained Node2Vec graph embeddings (no API call).
#                   Fast and free. Good for structural graph queries.
#                   Weakness: language-blind — Italian queries may miss English node names.
#
#   hybrid_semantic Node2Vec (40%) + semantic text embeddings (60%).
#                   One API call per query to EMBEDDING_MODEL.
#                   Recommended for production: handles Italian, synonyms, paraphrases.
#                   Score = 0.4 * node2vec_score + 0.6 * semantic_score
#
#   openai_only     Pure semantic embeddings, no graph structure signal.
#                   Use only if Node2Vec model is unavailable for a domain.
#
EMBEDDING_MODE=hybrid_semantic

# Embedding model — OpenRouter format (provider/model).
# Used only when EMBEDDING_MODE=hybrid_semantic or openai_only.
# WARNING: if you change this model, delete artifacts/embeddings_cache/ to rebuild the cache.
#          Node vectors and query vectors must be from the same model (same dimensions).
# Recommended models and their output dimensions:
#   openai/text-embedding-3-small   1536 dims  <- recommended (best price/quality, multilingual)
#   openai/text-embedding-3-large   3072 dims  better quality, higher cost, requires cache rebuild
#   openai/text-embedding-ada-002   1536 dims  older, worse than 3-small, compatible with cache
EMBEDDING_MODEL=openai/text-embedding-3-small

# Hybrid weight alpha: share of Node2Vec score (1-alpha goes to semantic score)
# 0.4 = 40% graph structure + 60% semantic meaning (tuned for educational Q&A)
EMBEDDING_NODE2VEC_WEIGHT=0.4

# Minimum semantic similarity score to consider a node relevant (0.0-1.0)
EMBEDDING_SEMANTIC_THRESHOLD=0.7

# Directory for caching node embeddings (auto-created, excluded from git)
EMBEDDINGS_CACHE_DIR=artifacts/embeddings_cache

# Enable embedding caching (set false to always re-embed — useful for debugging)
EMBEDDING_CACHE_EMBEDDINGS=true


# ============================================================
# NODE2VEC MODEL
# ============================================================

# Directory containing pre-trained Node2Vec model files (.pkl, .npz, .json)
NODE2VEC_MODEL_DIR=./artifacts/node2vec


# ============================================================
# TEXT2CYPHER CONFIGURATION
# ============================================================

# Model for Cypher generation and Italian→English translation.
# Use a fast/cheap model — this is a structured transformation task, not creative writing.
# Separate from LLM_MODEL (used for final lesson plan generation).
# Recommended: google/gemini-2.0-flash (~2-3s) or openai/gpt-4o-mini
# If not set, falls back to LLM_MODEL.
TEXT2CYPHER_MODEL=google/gemini-2.5-flash

# Maximum length of the teacher query passed to the Cypher generator
TEXT2CYPHER_MAX_QUERY_LENGTH=1000

# Default maximum number of results returned by generated Cypher queries
TEXT2CYPHER_DEFAULT_LIMIT=20

# Validate generated Cypher before executing (catches syntax errors)
TEXT2CYPHER_ENABLE_VALIDATION=true

# Actually execute the Cypher query against Neo4j (set false for dry-run testing)
TEXT2CYPHER_ENABLE_EXECUTION=true


# ============================================================
# EXTERNAL MEDIA APIs (Optional — used by ExternalMediaAPI in Agent mode)
# ============================================================
# YouTube: no API key needed — the media pool agent uses yt-dlp + oEmbed (no quota).
# Semantic Scholar: optional key unlocks higher rate limits.

# Semantic Scholar API key — request free at https://www.semanticscholar.org/product/api#api-key
# Approval takes ~24-48h. Unlocks 1 000 req / 5 min (vs 100 without key).
# SEMANTIC_SCHOLAR_API_KEY=your-key-here

# YouTube Data API v3 key — enables LIVE, query-specific video search in the
# media panel. How to get one: Google Cloud Console → New Project → enable
# "YouTube Data API v3" → Credentials → Create credentials → API key →
# restrict the key to "YouTube Data API v3". Quota is 10 000 units/day and a
# search costs 100 units (~100 searches/day), which is why the live layer
# caches results. WITHOUT a key the system still works: videos fall back to the
# curated pool + DuckDuckGo links (papers/Wikipedia/web need no key).
# YOUTUBE_API_KEY=AIza...


# ============================================================
# DYNAMIC MEDIA LAYER (Dynamic_Media_Retrieval_Plan.md — Phase 0 scaffolding)
# ============================================================
# Master switch. When false (default), behavior is identical to today: the
# media panel is served from the curated JSON pool only and NO live calls are
# made. Turning it on enables the off-critical-path live layer (YouTube +
# OpenAlex + Wikipedia + DDGS) that streams query-specific media into the side
# panel WITHOUT adding latency to lesson generation.
# AIX_MEDIA_LIVE_ENABLED=false

# Per-bucket result caps (defaults match today's panel density).
# AIX_MEDIA_MAX_VIDEOS=5
# AIX_MEDIA_MAX_PAPERS=3
# AIX_MEDIA_MAX_WEB=6

# Cache backend for live results (off-path; never on the request critical path).
#   dev  → diskcache (default when no Redis URL is set; on-disk, no extra infra)
#   prod → redis (reuse the shared instance; entries isolated under the namespace)
# AIX_MEDIA_CACHE_BACKEND=diskcache        # diskcache | redis | none
# AIX_MEDIA_CACHE_NAMESPACE=aix:media:v1   # bump the suffix to invalidate all media cache
# AIX_MEDIA_CACHE_TTL=1209600              # seconds (14 days)
# AIX_MEDIA_CACHE_DIR=artifacts/media_cache
# AIX_MEDIA_REDIS_URL=redis://localhost:6379/0   # falls back to REDIS_URL if unset

# Background refresh job (Q5) — runs as a SEPARATE scheduled process, never in
# the web app. Optional: if it never runs, request-time falls back to an
# off-path async fetch, so behavior is unaffected.
# AIX_MEDIA_REFRESH_ENABLED=false

# Phase 3 — semantic re-ranking of the live items against the teacher's query +
# the generated lesson content. Off by default: with it off the live items keep
# their fetch order (Phase 1/2 behavior). It only changes WHICH items survive the
# per-bucket caps and in WHAT order — never the counts. Runs off the critical
# path and is fully fail-safe (falls back to fetch order on any error). Blended
# score = W_SEMANTIC·cosine(item, query+content) + W_QUALITY·signal (citations +
# recency for papers; semantic-only for videos/Wikipedia in this phase).
# AIX_MEDIA_RERANK_ENABLED=false
# AIX_MEDIA_RERANK_W_SEMANTIC=0.7
# AIX_MEDIA_RERANK_W_QUALITY=0.3


# ============================================================
# LM STUDIO — LOCAL MEDIA POOL AGENT (scripts/media_pool/)
# ============================================================
# Used by the offline media pool generation scripts, NOT by the live API.
# LM Studio must be running locally with a tool-calling capable model.
# Any 7B+ model with function-calling support works (Gemma 4, Llama 3.1, Qwen 2.5, Mistral).
#
# To run the pool agent:
#   1. Start LM Studio and load a model
#   2. Enable the local server (Settings → Local Server → Start)
#   3. Run: python scripts/media_pool/00_preflight.py
#   4. Run: python scripts/media_pool/01_run_pool_agent.py --domain neuro
#
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b


# ============================================================
# DOCKER / CONTAINER CONFIGURATION
# ============================================================

# Port exposed on the host machine (maps to internal port 8000)
API_CONTAINER_PORT=8000

# Docker container name (used by docker-compose and docker ps)
API_CONTAINER_NAME=graphrag-aixlearning-api


# ============================================================
# ERROR MONITORING — GLITCHTIP (Sentry-compatible)
# ============================================================
# Leave SENTRY_DSN empty or commented out to disable monitoring entirely.
# When set, unhandled exceptions and slow API requests are reported to GlitchTip.
# Get your DSN from your GlitchTip project -> Settings -> DSN.
#
# traces_sample_rate (hardcoded at 0.2 in api/main.py) means 20% of requests
# are traced for performance monitoring — enough to spot slow endpoints without
# overwhelming the dashboard.
#
# ENVIRONMENT controls the label shown in the GlitchTip issue list:
#   production  -> live server, alerts enabled
#   staging     -> pre-production testing
#   development -> local dev, alerts typically muted in GlitchTip
#
SENTRY_DSN=https://your-key@app.glitchtip.com/your-project-id
ENVIRONMENT=production


# ============================================================
# PROMPT MANAGEMENT / OBSERVABILITY — LANGFUSE
# ============================================================
# Langfuse is used today for dynamic prompt management. Tracing/dashboard
# usage is production observability work under CORE 2 #11b.
# Leave these empty to fall back to static local prompts.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# ============================================================
# LOGGING
# ============================================================

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG locally to see Cypher queries, embedding scores, and thinking tokens.
# Use INFO or WARNING in production to reduce noise.
LOG_LEVEL=INFO


# ============================================================
# WEBUI — Path C Mirror Stack (CORE 2 #6.6 P1)
# ============================================================
#
# These settings only affect the in-process /webui surface (HTML pages
# under /webui/* and /auth/*). The public DEV-facing /api/v1 contract is
# unaffected.
#
# WEBUI_AUTH_SECRET
#   Secret used to sign JWT tokens stored in the auth cookie AND password-
#   reset / verification tokens. MUST be a long random string in any
#   non-local environment. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   If unset, a dev-only fallback is used and a WARNING is logged.
WEBUI_AUTH_SECRET=replace-me-with-secrets-token-urlsafe-48
#
# WEBUI_DATABASE_URL  (optional — defaults to SQLite at data/webui/webui.db)
#   Async SQLAlchemy URL for the webui's user + lesson store.
#   Examples:
#     sqlite+aiosqlite:///./data/webui/webui.db          (dev default)
#     postgresql+asyncpg://user:pass@host:5432/aix_webui (CORE 6 prod)
# WEBUI_DATABASE_URL=
#
# LANGGRAPH_DATABASE_URL  (optional — production checkpointer backend)
#   If set to a postgres/postgresql URL, the LangGraph conversation
#   checkpointer uses AsyncPostgresSaver. If unset, local dev uses
#   AsyncSqliteSaver at data/agent_threads.db.
#   Production compose derives this from POSTGRES_* values; local dev can
#   leave it unset unless you are testing Postgres explicitly.
# LANGGRAPH_DATABASE_URL=
#
# LANGGRAPH_CHECKPOINTER_URL  (optional — legacy / dev override)
#   For dev SQLite relocation only, e.g. sqlite:///./data/agent_threads.db.
#   Also accepts postgres URLs, but LANGGRAPH_DATABASE_URL is preferred.
# LANGGRAPH_CHECKPOINTER_URL=
#
# LANGGRAPH_PG_POOL_MAX  (default 20)
#   Max psycopg pool size when AsyncPostgresSaver is selected.
# LANGGRAPH_PG_POOL_MAX=20
#
# WEBUI_DB_ECHO  (default 0)
#   Set to 1 to see every SQL statement in the uvicorn log — useful when
#   debugging the form → DB path. Leave at 0 in production.
# WEBUI_DB_ECHO=0
#
# WEBUI_TOKEN_LIFETIME_SECONDS  (default 86400 = 24h)
#   How long a login session lasts before requiring re-auth.
# WEBUI_TOKEN_LIFETIME_SECONDS=86400
#
# WEBUI_COOKIE_SECURE  (default 0)
#   Set to 1 in production behind HTTPS so the auth cookie is only sent
#   over TLS. Leave at 0 in dev (HTTP localhost).
# WEBUI_COOKIE_SECURE=0
#
# WEBUI_COOKIE_NAME  (default aix_webui_auth)
#   Cookie name. Override only if you need to coexist with another auth
#   cookie on the same domain.
# WEBUI_COOKIE_NAME=aix_webui_auth


# ============================================================
# SERVICE-TO-SERVICE AUTH  (AixLearning integration — Mode B)
# ============================================================
#
# GRAPH_API_USERNAME / GRAPH_API_PWD
#   HTTP Basic Auth credentials for service-to-service calls on
#   POST /api/v1/agent/run and /api/v1/agent/stream.
#   Used by the AixLearning Dramatiq worker wrapper (AgenticGraphRagService)
#   in the same way GRAPH_API_USERNAME/GRAPH_API_PWD are already used for
#   /api/v1/context. If both vars are unset, Basic Auth is rejected and only
#   Bearer JWT / cookie auth is accepted (standalone WebUI behaviour).
#   Generate a strong password with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# GRAPH_API_USERNAME=aix-service
# GRAPH_API_PWD=replace-me-with-secrets-token-urlsafe-32


# ============================================================
# AGENT TUNING FLAGS  (CORE 2 #9 + #11a — May 2026)
# ============================================================
# All flags below are read with sensible defaults via os.getenv(). If you
# don't set them, the system behaves exactly as it did pre-#9/#11a. They
# exist so ops can flip behaviour at runtime without a code deploy.

# AIX_CORRECTIVE_RAG_ENABLED  (default: false)
#   Master switch for CORE 2 #9 — Corrective RAG (Retrieval Grading).
#   When true, a small grader LLM runs after the retriever and decides
#   whether the retrieved KG concepts are good enough to feed the writer.
#   Bad retrievals trigger a bounded retry loop with a rewritten query;
#   exhausting the budget surfaces a low-confidence caveat in the lesson.
#   Topology when OFF (default) — byte-identical to pre-#9:
#       plan → retrieve → write → critique
#   Topology when ON:
#       plan → retrieve → grade_retrieval ─[continue]→ write → critique
#                              │
#                              └─[retry]→ retrieve
# AIX_CORRECTIVE_RAG_ENABLED=false

# AIX_CORRECTIVE_RAG_MAX_ATTEMPTS  (default: 2, clamped to 1-4)
#   Max number of retrieve→grade passes per turn when the feature is on.
#   After max_attempts with grade != "relevant", the loop falls through
#   to the writer with retrieval_warning=True (the lesson then carries an
#   explicit low-confidence note for the teacher). Higher values = more
#   LLM cost per turn; lower values = quicker fallback. 2 is a good start.
# AIX_CORRECTIVE_RAG_MAX_ATTEMPTS=2

# AIX_CRITIC_PARSE_ERROR_BEHAVIOR  (default: approve — legacy backward-compat)
#   What the Critic agent does when the LLM returns unparseable JSON.
#     approve  Legacy: return CritiqueResult(decision=APPROVE, summary=
#              "Approved due to parsing error"). Same behaviour as pre-#11a.
#              Lessons ship despite the parse failure (silent-fail risk).
#     revise   Force one revision pass with a [parse_error] marker in
#              revision_instructions. Surfaces the failure to the writer-
#              revise loop. Recommended once #11a's json_mode hardening has
#              been validated to keep the parse-error rate near zero.
#     raise    Re-raise the JSONDecodeError, hard-failing the run.
#              Best for staging environments where you want to investigate
#              every parse failure end-to-end.
# AIX_CRITIC_PARSE_ERROR_BEHAVIOR=approve

# AIX_CRITIC_MODEL  (default: TEXT2CYPHER_MODEL → google/gemini-2.5-flash)
#   Model used exclusively by the Critic Agent. The Critic outputs ~300 tokens
#   of structured JSON (5 scores + decision + summary) — a classification task
#   that a fast, cheap model handles in 2-4s vs 25-30s for LLM_MODEL.
#   Defaults to TEXT2CYPHER_MODEL so you only need one "fast model" setting.
#   Override only if you want the Critic on a different model than Text2Cypher.
# AIX_CRITIC_MODEL=google/gemini-2.5-flash

# AIX_CRITIC_LESSON_MAX_CHARS  (default: 3000)
#   Max chars of the lesson plan passed to the Critic. Uses head(2/3)+tail(1/3)
#   so all sections (objectives, activities, differentiation, assessment) are visible.
#   Reducing prefill from ~8 000 to ~3 000 chars saves ~10-15s of TTFT.
# AIX_CRITIC_LESSON_MAX_CHARS=3000

# AIX_CRITIC_CONTEXT_MAX_CHARS  (default: 1200)
#   Max chars of retrieved context (KG concepts + methodologies, no media).
#   The Critic only needs concept names and strategy titles for Evidence Grounding.
# AIX_CRITIC_CONTEXT_MAX_CHARS=1200

# AIX_WRITER_MAX_TOKENS  (default: 2500, range: 1500–8000)
#   Hard token ceiling for the Writer LLM output. Pairs with the prompt-level
#   "max 1 600 words" guideline — the prompt guides the model to conclude
#   naturally while this cap prevents runaway generation.
#   At ~3 chars/token (Italian markdown): 2500 ≈ 7 500–8 000 chars.
#   Tuning guide:
#     2000  →  ~6 000 chars  — very concise, fastest (~20–25s write time)
#     2500  →  ~8 000 chars  — balanced quality/speed (~30–36s)
#     3500  →  ~10 500 chars — richer lessons, ~50% slower than default  [default]
#     3500  →  ~10 500 chars — richer lessons, ~50% slower than default
#     8000  →  pre-optimisation legacy behaviour (~58s)
# AIX_WRITER_MAX_TOKENS=3500

# AIX_WRITER_MAX_CONTINUATIONS  (default: 1, range: 0-3)
#   When the writer hits AIX_WRITER_MAX_TOKENS and finish_reason="length",
#   the agent automatically makes this many additional LLM calls to finish
#   the lesson where it stopped. Streaming continuations feed the same SSE
#   bus so the user sees uninterrupted output. 0 disables continuation
#   (legacy behaviour — lesson is delivered truncated). 1 is enough for
#   any realistic lesson; 2+ exists for verbose hybrid lessons with many
#   external citations.
# AIX_WRITER_MAX_CONTINUATIONS=1

# AIX_THINKING_EFFORT  (default: medium — applies to Claude Sonnet/Opus 4.x and DeepSeek R1)
#   Controls how many thinking tokens the reasoning model produces before writing the lesson.
#   Claude Sonnet 4.6 is recognised as a reasoning model by default; no model switch needed.
#   low    ~1 024 tokens — fast, brief reasoning trace (default; safest for 3 500-token budget)
#   medium ~4 000 tokens — richer reasoning but requires ~6 000 extra tokens above content budget
#   high   ~8 000 tokens — deep pedagogical reasoning, highest cost, ~10 000 extra tokens needed
#   Thinking tokens stream live so teachers see the AI reasoning before the lesson appears;
#   the purple "💭 Elaborazione pedagogica…" accordion collapses when lesson content starts.
#   IMPORTANT: When changing effort, the server adds the right extra token buffer automatically.
# AIX_THINKING_EFFORT=low

# AIX_MAX_REVISIONS  (default: 1, range: 0–4)
#   Maximum Writer→Critic revision cycles per lesson generation run.
#   0 = no critic (fastest, skip review entirely).
#   1 = one cycle (default: Writer drafts, Critic reviews once, done).
#   2 = two cycles (pre-optimization legacy default — higher quality but slower).
#   Higher values increase latency by ~4–8s per extra cycle.
# AIX_MAX_REVISIONS=1

# AIX_LLM_PROBE_ENABLED  (default: true)
#   Whether to run the LLM-endpoint connectivity probe at FastAPI startup
#   (src/aix/core/connectivity_probe.py). The probe issues a one-shot
#   GET /models against the configured base_url and emits ONE actionable
#   log line that distinguishes:
#     * TLS certificate failure  (exact root cause + remediation hints)
#     * Connection / DNS error
#     * Read timeout
#     * 401 / 403 auth failure
#     * 4xx / 5xx upstream error
#   This solves the "Connection error." mystery that hides three different
#   failure modes inside the OpenAI SDK's retry layer. Default-on; flip to
#   false in air-gapped or test environments where outbound HTTPS is
#   intentionally blocked.
# AIX_LLM_PROBE_ENABLED=true

# ---------------------------------------------------------------------------
# Concurrency controls (CORE 6 — Phase A, single-worker hardening)
# ---------------------------------------------------------------------------
# Process-wide limits enforced in src/aix/core/concurrency.py. They are
# PER-PROCESS (asyncio.Semaphore); multi-worker coordination is Phase B.
# Defaults are sane for one larger VM serving tens of teachers.

# AIX_MAX_CONCURRENT_RUNS  (default: 6, clamped to 1-128)
#   Max number of full agent pipelines (plan→retrieve→write→critique) that may
#   run simultaneously. The 7th+ concurrent request waits in a short queue
#   (see AIX_RUN_QUEUE_TIMEOUT_S) and, if still no slot, is shed with a
#   friendly "sistema occupato" message (webui card / 503 on the JSON API).
# AIX_MAX_CONCURRENT_RUNS=6

# AIX_RUN_QUEUE_TIMEOUT_S  (default: 5.0, min 0)
#   How long a request waits for a free run slot before load-shedding.
#   0 = no queue (shed immediately when full); higher = more patience but
#   longer worst-case wait before the teacher sees the busy message.
# AIX_RUN_QUEUE_TIMEOUT_S=5.0

# AIX_MAX_CONCURRENT_LLM_CALLS  (default: 12, clamped to 1-512)
#   Hard ceiling on simultaneous outbound LLM calls across ALL runs, to
#   protect against provider 429s / cost spikes. This blocks (does not shed):
#   a run already holds a run slot, so its LLM calls just queue briefly.
# AIX_MAX_CONCURRENT_LLM_CALLS=12

# AIX_USER_RATE_LIMIT  (default: 10, 0 disables, clamped to 0-100000)
#   Per-user budget: how many runs a single teacher may START within the
#   rolling window below. Excess attempts are rejected with a friendly 429
#   ("troppe generazioni in poco tempo") + a Retry-After hint, WITHOUT
#   consuming a run slot. Checked at run initiation (webui POST /run, API
#   /run and /stream); stream reconnects don't count. Keyed per-process as
#   webui:<user-id> / api:<caller>; cross-worker fairness is Phase B (Redis).
# AIX_USER_RATE_LIMIT=10

# AIX_USER_RATE_WINDOW_S  (default: 60.0, min 1.0)
#   Length of the rolling window (seconds) for AIX_USER_RATE_LIMIT.
# AIX_USER_RATE_WINDOW_S=60.0
