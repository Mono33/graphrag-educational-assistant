# =============================================================================
# AIxLearning — configurazione minima
# =============================================================================
#
# Copia questo file in `.env` e compila le sei voci della prima sezione.
# Tutto il resto ha un default che funziona.
#
# Questo file conteneva 95 variabili, di cui 65 commentate: era una
# documentazione travestita da configurazione, e ne mancavano comunque 24 che il
# codice legge davvero. L'elenco completo — ogni variabile, il suo default, cosa
# succede se non la imposti — sta in `docs/ENVIRONMENT.md`.

# -----------------------------------------------------------------------------
# 1. Obbligatorie — senza queste l'applicazione non fa il suo lavoro
# -----------------------------------------------------------------------------

# Modello e provider. La chiave OpenRouter è quella che serve; OPENAI_API_KEY
# resta accettata come ripiego storico.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5.5

# Un modello per ogni ruolo, tutti via OpenRouter. Per cambiarne uno: cambia la
# riga e riavvia l'app. Una riga vuota o assente usa il valore predefinito nel
# codice, che è quello qui sotto. Confronti e motivi: docs/ENVIRONMENT.md.
AIX_CRITIC_MODEL=google/gemini-3.5-flash-lite
# Risposte veloci dopo la prima lezione. Vuoto = lo stesso del Writer (LLM_MODEL).
AIX_CHAT_MODEL=
TEXT2CYPHER_MODEL=google/gemini-3.1-flash-lite
AIX_OCR_MODEL=google/gemini-3.5-flash-lite
AIX_DOCUMENT_MAP_MODEL=google/gemini-3.5-flash-lite
# Vuoto = lo stesso del Writer (LLM_MODEL).
AIX_CITATION_CHECK_MODEL=
# Vuoto = lo stesso del Writer. Un modello economico solo dopo
# `scripts/eval/compare_role_models.py planner --retrieval`; un piano incerto
# viene comunque richiesto al Writer (AIX_PLANNER_ESCALATE, acceso).
AIX_PLANNER_MODEL=
# Quanto ragiona Claude prima di rispondere. `low` costa ~40% in meno e non
# tronca le lezioni; `default` lascia decidere il modello (vedi docs/ENVIRONMENT.md).
AIX_THINKING_EFFORT=low
# Le relazioni del grafo arrivano al Writer (preferite alla lettura alla cieca, ~$0,005 a lezione).
AIX_WRITER_GRAPH_RELATIONS=true
# La parte stabile del prompt (lo schema di text2cypher) è fatturata a un decimo
# alle ripetizioni. `false` la rimanda come testo semplice.
AIX_PROMPT_CACHE_ENABLED=true
# Risposte del grafo e verdetti del giudice ricordati fra i turni. Dopo ogni
# ingestione del grafo cambia AIX_KG_VERSION (qualsiasi etichetta nuova).
AIX_RESULT_CACHE_ENABLED=true
AIX_KG_VERSION=

# Knowledge Graph (Neo4j). Senza, il recupero delle strategie didattiche non
# funziona e le lezioni restano senza fondamento pedagogico.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Firma dei token di sessione della WebUI. **Non lasciarla vuota in produzione:**
# se manca, l'applicazione parte lo stesso con un valore di sviluppo che è nel
# codice sorgente, e scrive un avviso nel log. Genera una stringa lunga e casuale.
WEBUI_AUTH_SECRET=

# -----------------------------------------------------------------------------
# 2. Da decidere per l'ambiente — hanno un default, ma di solito lo si cambia
# -----------------------------------------------------------------------------

# `development` allenta alcune protezioni; in produzione lascia `production`.
ENVIRONMENT=production

# Cookie solo su HTTPS. 1 in produzione (dietro Caddy), 0 in locale.
WEBUI_COOKIE_SECURE=0

# Database della WebUI. Vuoto = SQLite in `data/webui/webui.db`.
# In produzione: postgresql+asyncpg://utente:password@host/database
WEBUI_DATABASE_URL=

# -----------------------------------------------------------------------------
# 3. Funzioni nuove — accese di default dal 2026-10-05 (i default sono quelli
#    del pilota). Per spegnerne una: false. Cosa comporta ciascuna:
#    docs/ENVIRONMENT.md.
# -----------------------------------------------------------------------------

# Parser nuovo sulla graffetta: DOCX, PPTX, immagini, controllo dei byte, OCR.
AIX_UPLOAD_PARSER_ENABLED=true

# Pipeline durevole dei materiali: storage, code, worker di ingestione.
AIX_MATERIALS_ENABLED=true

# RAG privato: i documenti vengono divisi in pezzi ed embeddati.
# ⚠️ Con questa accesa il testo dei materiali esce dalla macchina verso il
# provider di embedding (OpenRouter, account con Zero Data Retention).
AIX_PRIVATE_RAG_ENABLED=true

# Validatore dei vincoli d'aula: blocca la lezione quando una regola non torna.
AIX_VALIDATOR_ENABLED=false

# -----------------------------------------------------------------------------
# 4. Chiavi di servizi esterni — opzionali, ognuna spegne solo la sua funzione
# -----------------------------------------------------------------------------

# Video suggeriti nella lezione.
YOUTUBE_API_KEY=

# Tracciamento dei prompt (Langfuse). Senza, si usano i prompt nel codice.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Errori in produzione (Sentry). Vuoto = nessun invio.
SENTRY_DSN=

# =============================================================================
# Tutto il resto — code, cache, OCR, limiti del Writer, MCP, text2cypher,
# storage S3 — ha un default ragionevole ed è documentato in
# docs/ENVIRONMENT.md. Aggiungi qui solo ciò che stai davvero cambiando.
# =============================================================================
